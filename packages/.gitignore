# ============================================
# Packages Directory - .gitignore
# ============================================

# Node modules
node_modules/
*/node_modules/

# Build outputs
dist/
build/
*/dist/
*/build/

# Dependencies
*.tgz
package-lock.json

# Environment files
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Cache
.cache/
.eslintcache

# Temporary files
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db
