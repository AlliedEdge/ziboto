# ============================================
# Docker Infrastructure - .gitignore
# ============================================

# Environment files with secrets
.env
.env.*
!.env.example

# Docker runtime data
data/
volumes/
docker-data/
postgres-data/
redis-data/
rabbitmq-data/

# Docker compose overrides (local only)
docker-compose.override.yml

# Logs
logs/
*.log

# Temporary files
*.tmp
*.temp

# Backup files
*.backup
*.bak
