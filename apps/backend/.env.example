# Spring Configuration
SPRING_PROFILES_ACTIVE=dev

# Server Configuration
SERVER_PORT=8080

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/ziboto
DATABASE_USERNAME=ziboto
DATABASE_PASSWORD=ziboto
DATABASE_POOL_SIZE=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=ziboto
RABBITMQ_PASSWORD=ziboto123
RABBITMQ_VHOST=/

# Elasticsearch Configuration
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_CONNECTION_TIMEOUT=10s
ELASTICSEARCH_SOCKET_TIMEOUT=30s

# Redis Rate Limiting
REDIS_RATE_LIMIT_LOGIN_MAX=5
REDIS_RATE_LIMIT_LOGIN_WINDOW=15
REDIS_RATE_LIMIT_SIGNUP_MAX=3
REDIS_RATE_LIMIT_SIGNUP_WINDOW=60
REDIS_RATE_LIMIT_API_MAX=100
REDIS_RATE_LIMIT_API_WINDOW=1
REDIS_RATE_LIMIT_REFRESH_MAX=10
REDIS_RATE_LIMIT_REFRESH_WINDOW=1

# Redis Failed Login Tracking
REDIS_FAILED_LOGIN_MAX=5
REDIS_FAILED_LOGIN_LOCKOUT=30
REDIS_FAILED_LOGIN_TRACKING=1

# Redis Session Cache
REDIS_SESSION_TTL=1
REDIS_SESSION_EXTENDED_TTL=24
REDIS_SESSION_SLIDING_WINDOW=true
REDIS_SESSION_MAX_CONCURRENT=0

# Redis Token Blacklist
REDIS_TOKEN_BLACKLIST_ENABLED=true
REDIS_TOKEN_BLACKLIST_MAX_TTL=7

# Redis OTP Configuration
REDIS_OTP_TTL=5
REDIS_OTP_MAX_ATTEMPTS=3
REDIS_OTP_RATE_LIMIT=15
REDIS_OTP_MAX_VERIFY=3

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production-minimum-256-bits
JWT_EXPIRATION=900000 # 15 minutes in milliseconds
JWT_REFRESH_EXPIRATION=604800000 # 7 days in milliseconds

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# OAuth Redirect URL (frontend callback)
OAUTH_REDIRECT_URL=http://localhost:5173/oauth/callback

# Storage Configuration
STORAGE_TYPE=s3
STORAGE_LOCAL_PATH=./storage

# AWS S3 Configuration
# DO NOT set AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here
# Use AWS credential provider chain (AWS CLI, environment, IAM role)
AWS_REGION=eu-north-1
AWS_S3_BUCKET=ziboto-files-277522752099-eu-north-1-an
AWS_S3_MULTIPART_THRESHOLD=104857600
AWS_S3_PART_SIZE=10485760
AWS_S3_MAX_CONCURRENCY=10
AWS_S3_PRESIGNED_URL_EXPIRATION=15
AWS_S3_ENABLE_ENCRYPTION=true
AWS_S3_STORAGE_CLASS=STANDARD
AWS_S3_ENABLE_VERSIONING=false
AWS_S3_KEY_PREFIX=files/
AWS_S3_CONNECTION_TIMEOUT=10000
AWS_S3_READ_TIMEOUT=60000

# File Upload Configuration
MAX_FILE_SIZE=100MB
MAX_REQUEST_SIZE=100MB

# Cache Configuration
CACHE_TTL=3600

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FILE=logs/ziboto.log

# Resend Email Configuration
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=Ziboto
RESEND_VERIFICATION_URL=http://localhost:5173/verify-email
RESEND_RESET_URL=http://localhost:5173/reset-password
RESEND_SUPPORT_EMAIL=support@yourdomain.com
